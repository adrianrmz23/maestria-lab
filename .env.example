# Maestría Lab · v1.0.6
# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REEMPLAZA_ESTE_VALOR
SUPABASE_SECRET_KEY=sb_secret_REEMPLAZA_ESTE_VALOR

# OpenAI · motor pedagógico, tutor y embeddings · solo servidor
OPENAI_API_KEY=sk-proj_REEMPLAZA_ESTE_VALOR
OPENAI_MODEL=gpt-5-mini
# Opcional. Debe producir 1536 dimensiones con la migración 008 actual.
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Kimi / Moonshot · OPCIONAL · solo servidor
# Se usa preferentemente para enriquecimiento del lector y conexiones globales.
KIMI_API_KEY=REEMPLAZA_ESTE_VALOR
KIMI_MODEL=kimi-k2.6


# ElevenLabs · resúmenes de audio por módulo · solo servidor
ELEVENLABS_API_KEY=REEMPLAZA_ESTE_VALOR
# Selecciona una voz en ElevenLabs y pega aquí su voice_id.
ELEVENLABS_VOICE_ID=REEMPLAZA_ESTE_VALOR
# Flash v2.5 = opción económica/equilibrada. Puedes cambiar a eleven_multilingual_v2 si priorizas calidad.
ELEVENLABS_MODEL=eleven_flash_v2_5

# Protección personal para despliegues · OPCIONAL
# Si existe, toda la app (incluidas APIs) queda detrás de una contraseña HttpOnly.
APP_ACCESS_PASSWORD=elige-una-contrasena-larga-y-unica

# Academic Task Studio · Bloque 12 · OPCIONAL
# Si no defines modelos específicos, reutiliza OPENAI_MODEL / KIMI_MODEL.
OPENAI_TASK_MODEL=
KIMI_TASK_MODEL=
DEEPSEEK_API_KEY=REEMPLAZA_ESTE_VALOR
DEEPSEEK_TASK_MODEL=deepseek-chat
